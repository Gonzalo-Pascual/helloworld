pipeline {
    agent none 

    stages {

        stage('Get Code') {
            agent { label 'agent1' } 
            steps {
                // whoami/hostname obligatorio según enunciado
                bat 'whoami'
                bat 'hostname'
                bat 'echo %WORKSPACE%'

                git 'https://github.com/Gonzalo-Pascual/helloworld.git'

                stash name: 'source-code', includes: '**/*'
            }
        }

        stage('Tests') {
            parallel {
                stage('Unit') {
                    agent { label 'agent1' } 
                    steps {
                        bat 'whoami'
                        bat 'hostname'
                        bat 'echo %WORKSPACE%'

                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            bat '''
                                set PYTHONPATH=%WORKSPACE%
                                coverage run --branch --source=app --omit=app\\_init_.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
                                coverage xml
                            '''
                        }
                    
                        stash name: 'coverage-report', includes: 'coverage.xml, result-unit.xml' 
                    }
                }

                stage('Rest') {
                    agent { label 'agent1' }
                    steps {
                        bat 'whoami'
                        bat 'hostname'
                        bat 'echo %WORKSPACE%'
                
                        unstash 'source-code'
                
                        bat '''
                            set FLASK_APP=app\\api.py
                            set FLASK_ENV=development
                            start /B flask run
                
                            start /B java -jar "C:\\Users\\gonza\\Documents\\Trabajos\\UNIR\\wiremock-standalone-3.13.2.jar" --port 9090 --root-dir test\\wiremock
                            set PYTHONPATH=%WORKSPACE%
                            pytest --junitxml=result-rest.xml test\\rest
                        '''
                    }
                }
            }
        }

        // Static y Security ahora también en paralelo (antes eran secuenciales)
        stage('Quality Analysis') {
            parallel {
                stage('Static') {
                    agent { label 'agent2' }
                    steps {
                        bat 'whoami'
                        bat 'hostname'
                        bat 'echo %WORKSPACE%'

                        unstash 'source-code'

                        bat '''
                            flake8 --exit-zero --format=pylint app > flake8.out
                        '''
                        recordIssues(
                            id: 'flake8_static',
                            tools: [pyLint(name: 'Flake8', pattern: 'flake8.out')],
                            qualityGates: [
                                [threshold: 8, type: 'TOTAL', unstable: true],
                                [threshold: 10, type: 'TOTAL', unstable: false]
                            ]
                        )
                    }
                }

                stage('Security') {
                    agent { label 'agent2' }
                    steps {
                        bat 'whoami'
                        bat 'hostname'
                        bat 'echo %WORKSPACE%'
                        unstash 'source-code'
                        bat '''
                            bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                        '''
                        recordIssues(
                            id: 'bandit_security',
                            tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                            qualityGates: [
                                [threshold: 2, type: 'TOTAL', unstable: true],
                                [threshold: 4, type: 'TOTAL', unstable: false]
                            ]
                        )
                    }
                }
            }
        }

        stage('Coverage') {
            agent { label 'agent1' } 
            steps {
                bat 'whoami'
                bat 'hostname'
                bat 'echo %WORKSPACE%'

                unstash 'coverage-report'

                recordCoverage(
                    qualityGates: [
                        [threshold: 95.0, metric: 'LINE'],
                        [threshold: 85.0, metric: 'LINE'],
                        [threshold: 90.0, metric: 'BRANCH'],
                        [threshold: 80.0, metric: 'BRANCH']
                    ],
                    tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']]
                )
            }
        }

        stage('Performance') {
            agent { label 'agent1' }
            steps {
                bat 'whoami'
                bat 'hostname'
                bat 'echo %WORKSPACE%'
        
                unstash 'source-code'
        
                bat '''
                    set FLASK_APP=app\\api.py
                    set FLASK_ENV=development
                    start /B flask run
        
                    "C:\\Users\\gonza\\Documents\\GitHub\\helloworld\\apache-jmeter-5.6.3\\bin\\jmeter.bat" -n -t test\\jmeter\\flask.jmx -f -l flask.jtl
                '''
                perfReport sourceDataFiles: 'flask.jtl'
            }
        }
    }

    post {
        always {
            node('agent1') {
                cleanWs deleteDirs: true, disableDeferredWipeout: true
            }
            node('agent2') {
                cleanWs deleteDirs: true, disableDeferredWipeout: true
            }
        }
    }
}
